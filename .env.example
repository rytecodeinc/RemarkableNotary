# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=CA Notary Course
NEXT_PUBLIC_PRODUCT_PRICE_DISPLAY=$79

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional: create Price in Stripe Dashboard ($79 one-time) and paste ID above.
# If empty, checkout creates a one-off price_data line item.

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=remarkable-notary
R2_PUBLIC_BASE_URL=
# R2_PUBLIC_BASE_URL optional; signed URLs are used for private media by default.
R2_ENDPOINT=
# If empty, endpoint is derived as https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Auth
# Enable Magic Link + Google in Supabase Auth providers.
# Site URL + redirect allow list should include:
#   http://localhost:3000/auth/callback
#   https://remarkablenotary.com/auth/callback
